{
  "name": "clinic-scheduling",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @clinic/api\" \"npm run dev -w @clinic/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @clinic/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @clinic/api",
    "db:migrate": "npm run db:migrate -w @clinic/api",
    "db:seed": "npm run db:seed -w @clinic/api"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^5.1.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.4.0",
    "concurrently": "^9.1.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0",
    "minimatch": "^11.0.1",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
