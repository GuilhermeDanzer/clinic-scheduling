{
  "name": "@clinic/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "tsx --env-file=../../.env scripts/integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@clinic/shared": "1.0.0",
    "fastify": "^5.2.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@prisma/client": "6.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "dotenv-cli": "^8.0.0"
  }
}
